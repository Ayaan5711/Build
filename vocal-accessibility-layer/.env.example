# Backend selection: mock | local | event  (asr) -- mock | ollama | event (llm) -- mock | event (embed)
ASR_BACKEND=mock
LLM_BACKEND=mock
EMBED_BACKEND=mock

# Filled in on match day
GENAILAB_API_KEY=

# Only needed if ASR_BACKEND=local
WHISPER_LOCAL_MODEL=base

# Only needed if LLM_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

CONFIDENCE_THRESHOLD=0.6
