# Backend selection: mock | local | event  (asr) -- mock | ollama | event (llm) -- mock | ollama | event (embed)
ASR_BACKEND=mock
LLM_BACKEND=mock
EMBED_BACKEND=mock
TTS_BACKEND=mock

# Match-day genailab.tcs.in access. Never commit a real key -- this file is
# a template only. Copy to .env (git-ignored) and fill in there.
GENAILAB_API_KEY=REPLACE_WITH_KEY_FROM_ORGANIZERS
# Confirmed against the live model list on match day -- gpt-4o-mini is the
# default because it follows structured-JSON instructions reliably (the
# Orchestrator/Guardrail depend on this). Alternates to try if you have time
# to compare quality: azure/genailab-maas-gpt-4.1, genailab-maas-DeepSeek-V3-0324,
# azure_ai/genailab-maas-Llama-3.3-70B-Instruct.
GENAILAB_CHAT_MODEL=azure/genailab-maas-gpt-4o-mini
GENAILAB_ASR_MODEL=azure/genailab-maas-whisper
GENAILAB_EMBED_MODEL=azure/genailab-maas-text-embedding-3-large

# Only needed if ASR_BACKEND=local
WHISPER_LOCAL_MODEL=base

# Only needed if LLM_BACKEND=ollama or EMBED_BACKEND=ollama. Model names
# confirmed against a real `ollama list` on the lab hardware -- use the
# exact names shown there, they don't match the upstream Ollama Hub tags
# (e.g. it's "llama-3.2-3b-it:latest", not "llama3.2:3b").
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama-3.2-3b-it:latest
OLLAMA_EMBED_MODEL=gte-large:latest

CONFIDENCE_THRESHOLD=0.6
