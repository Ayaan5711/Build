# --- PROFILE: the one switch that controls cost ----------------------------
# mock   -- everything offline, $0. No key, no hardware. (default)
# local  -- ASR via local faster-whisper, everything else Ollama. $0, offline.
# hybrid -- ASR + final response hosted, everything else local Ollama.
#           ~cents per demo. Recommended for match day.
# hosted -- everything hosted. Max accuracy, highest cost.
PROFILE=mock

# Budget guardrail: hosted calls are refused once estimated spend crosses
# this (pipeline then falls back to cached scenarios). Keep under the real cap.
BUDGET_USD_CAP=20.0

# Per-stage overrides (optional). Leave blank to let PROFILE decide. Set only
# to experiment, e.g. ASR_BACKEND=event with an otherwise-local profile.
ASR_BACKEND=          # mock | local | event
VISION_BACKEND=       # mock | local (MediaPipe Hands)
EMBED_BACKEND=        # mock | ollama | event
TTS_BACKEND=          # mock | local (espeak-ng, offline, optional)
# LLM: leave LLM_BACKEND blank to use the profile; or force ALL roles to one
# backend; or override a single role via LLM_BACKEND_RESPONSE=event etc.
LLM_BACKEND=          # (blank) | mock | ollama | event

# Match-day genailab.tcs.in access. Never commit a real key -- this file is
# a template only. Copy to .env (git-ignored) and fill in there.
GENAILAB_API_KEY=REPLACE_WITH_KEY_FROM_ORGANIZERS

# Model-per-role, matching the PRD's model table (section 7.1). Confirmed
# against the live model list on match day.
GENAILAB_ASR_MODEL=azure/genailab-maas-whisper
GENAILAB_EMBED_MODEL=azure/genailab-maas-text-embedding-3-large
GENAILAB_CLEANUP_MODEL=azure/genailab-maas-gpt-4o-mini
GENAILAB_REASONING_MODEL=azure_ai/genailab-maas-DeepSeek-R1
GENAILAB_INTENT_MODEL=azure/genailab-maas-gpt-4o-mini
GENAILAB_RESPONSE_MODEL=azure/genailab-maas-gpt-4o
GENAILAB_CAPTION_MODEL=azure/genailab-maas-gpt-4o-mini

# Only needed if ASR_BACKEND=local
WHISPER_LOCAL_MODEL=base

# Only needed if LLM_BACKEND=ollama or EMBED_BACKEND=ollama. Model names
# confirmed against a real `ollama list` on the lab hardware -- always
# re-verify with `ollama list` on the machine you're actually on.
OLLAMA_HOST=http://localhost:11434
OLLAMA_CLEANUP_MODEL=llama-3.2-3b-it:latest
OLLAMA_REASONING_MODEL=deepseek-r1:latest
OLLAMA_INTENT_MODEL=llama-3.2-3b-it:latest
OLLAMA_RESPONSE_MODEL=gemma-3-4b-it:latest
OLLAMA_CAPTION_MODEL=llama-3.2-3b-it:latest
OLLAMA_EMBED_MODEL=gte-large:latest

CONFIDENCE_THRESHOLD=0.6
FALLBACK_TO_CACHED_SCENARIOS=true
